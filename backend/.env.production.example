APP_ENV=production
DATABASE_URL=postgresql+psycopg://gymos:CHANGE_DATABASE_PASSWORD@db:5432/gymos
SECRET_KEY=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_URL=https://gym.example.com
ALLOWED_ORIGINS=https://gym.example.com
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
AUTH_RATE_LIMIT=15
UPLOAD_DIR=var/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
