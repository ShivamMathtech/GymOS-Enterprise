APP_ENV=development
DATABASE_URL=postgresql+psycopg://gymos:CHANGE_DATABASE_PASSWORD@127.0.0.1:5432/gymos
SECRET_KEY=CHANGE_RUN_SCRIPTS_CONFIGURE_PY_TO_GENERATE
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
ACCESS_MINUTES=10
REFRESH_DAYS=7
AUTH_RATE_LIMIT=15
UPLOAD_DIR=var/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=gymos@example.com
SMTP_STARTTLS=true
